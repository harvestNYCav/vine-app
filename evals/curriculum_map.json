      "new_grammar": [
        {
          "title": "Possessive adjectives: my, your, his, her, our, their",
          "rule": "A possessive adjective goes directly before a noun to show who it belongs to. It never stands alone — it always needs a noun right after it: my house, her phone, their car.",
          "examples": [
            "This is my house.",
            "This is his car. That is her phone.",
            "That is their car."
          ]
        },
        {
          "title": "\"Mine\" and reflexive pronouns: myself, himself, ourselves",
          "rule": "\"Mine\" replaces \"my + noun\" and stands alone with no noun after it: \"This bag is mine\" (not \"This bag is mine bag\"). Reflexive pronouns (myself, yourself, himself, herself, ourselves, themselves) show that someone did something alone, without help.",
          "examples": [
            "This bag is mine.",
            "I made this myself.",
            "We cleaned the house ourselves."
          ]
        }
      ]
