      "new_grammar": [
        {
          "title": "The verb \"to be\": am, is, are",
          "rule": "The verb \"to be\" changes depending on the subject. Use \"am\" only with \"I.\" Use \"is\" with he, she, it, or a single person/thing (your sister, the doctor). Use \"are\" with you, we, they, or more than one person/thing.",
          "examples": [
            "I am a student.",
            "She is my neighbor.",
            "We are ready.",
            "They are from Guatemala."
          ]
        },
        {
          "title": "Negatives, questions, and short forms",
          "rule": "To make a negative, add \"not\" after am/is/are: I am not sure. He is not home. To ask a question, put am/is/are before the subject: Are you okay? Is she your sister? In everyday speech, people often use short forms: I'm, he isn't, they aren't.",
          "examples": [
            "I am not sure.",
            "Is she your sister?",
            "He isn't home.",
            "They aren't ready."
          ]
        }
